{
  "ConnectionStrings": {
    "ConferenceAttendeeDatabaseConnection": "Server=host.docker.internal;Database=ConferenceAttendeeDb;User Id=MYUSERNAME;Password=MYSTRONGPASSWORD;Persist Security Info=true;Trusted_Connection=false;TrustServerCertificate=true;"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Debug",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://seq_logs" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "Properties": {
      "ApplicationName": "Conference Attendees API"
    }
  },
  "AllowedHosts": "*"
}